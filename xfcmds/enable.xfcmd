# xfcmds/enable.xfcmd
# libck micros → yes  |  libon micros
# Docs: https://github.com/fscss-ttr/micros.fscss
say "Setting up {name}@{version} by {author}"
say "Needs FSCSS {fscss}. Import: @import((*) from fscss:micros)"
add snippets for helpers
add snippet micros-import "import fscss:micros" as "@import((mirror, scoped-reset, stagger, stagger-items, alpha) from fscss:micros)"
add snippet micros-mirror "mirror index array" as "@arr \( {1:colors}[ \){2:#1E2783, #8C29B2, #C41348}]\n@mirror(${1:colors}, \( {3:index})\nexec(_log, \"@arr. \){3:index}\")"
add snippet micros-stagger "stagger delay" as "animation-delay: @stagger(${1:1}, ${2:0.2});"
add snippet micros-alpha "alpha color-mix" as "background: @alpha(${1:#8f6bff}, ${2:35%});"
create file "micros-demo/demo.fscss" with:
  /* micros demo — generated by xfcmd */
  @import((*) from fscss:micros)

  @scoped-reset(body)

  body {
    min-height: 100vh;
    display: grid;
    place-items: center;
    gap: 24px;
    background: #0b1220;
    color: #e8e3ff;
    font-family: system-ui, sans-serif;
  }

  @arr colors[#8f6bff, #4fffb0, #ff5e7d, #e8b13a]
  @mirror(colors, ci)

  .swatch-@arr.ci[] {
    width: 72px;
    height: 72px;
    border-radius: 12px;
    background: @arr.colors[@arr.ci[]];
    box-shadow: 0 8px 24px @alpha(@arr.colors[@arr.ci[]], 40%);
    animation: pop 0.6s ease both;
    animation-delay: @stagger(@arr.ci[], 0.12);
  }

  @keyframes pop {
    from { transform: scale(0.85); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
  }

  .row {
    display: flex;
    gap: 12px;
  }
end
create file "micros-demo/index.html" with:
  <!DOCTYPE html>
  <html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>micros.fscss demo</title>
    <link type="fscss" href="demo.fscss">
  </head>
  <body>
    <p style="opacity:0.7;font-size:13px;margin:0">fscss:micros — mirror + stagger + alpha</p>
    <div class="row">
      <div class="swatch-1"></div>
      <div class="swatch-2"></div>
      <div class="swatch-3"></div>
      <div class="swatch-4"></div>
    </div>
  </body>
  </html>
end
open file micros-demo/demo.fscss
compile
open file micros-demo/index.html
show preview
say "Done. Type mirror, stagger, or alpha in an .fscss file for snippets."
say "Import in other sheets: @import((*) from fscss:micros)"
